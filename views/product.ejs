<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= product ? product.name : "Product" %> • Imprev Clothing</title>

  <!-- favicon -->
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />

  <link rel="stylesheet" href="/style.css" />

  <style>
    /* Use favicon as visible logo (on-page). Tab icon color depends on the actual .ico file. */
    .brandMark{
      width:34px;height:34px;
      border-radius:10px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      box-shadow: 0 6px 18px rgba(0,0,0,.35);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }
    .brandMark img{
      width:22px;height:22px;
      display:block;
      filter: grayscale(1) brightness(1.35) contrast(1.15);
    }

    .crumbs{
      display:flex;
      gap:10px;
      align-items:center;
      margin: 10px 0 14px;
      color: rgba(238,241,255,.62);
      font-weight: 900;
      font-size: 13px;
    }
    .crumbs a{ color: rgba(238,241,255,.78); text-decoration:none; }
    .crumbs a:hover{ text-decoration: underline; }
    .dot{ opacity:.4; }

    .pWrap{
      display:grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 16px;
      align-items:start;
      margin-top: 10px;
    }
    @media (max-width: 980px){ .pWrap{ grid-template-columns: 1fr; } }

    .pCard{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
      overflow:hidden;
    }

    .gallery{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      overflow:hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }

    .galleryMain{
      position: relative;
      width: 100%;
      background: rgba(0,0,0,.20);
    }
    .galleryMain img{
      width:100%;
      height: 520px;
      object-fit: cover;
      display:block;
    }
    @media (max-width: 980px){ .galleryMain img{ height: 420px; } }
    @media (max-width: 520px){ .galleryMain img{ height: 340px; } }

    .thumbs{
      display:flex;
      gap:10px;
      padding: 12px;
      border-top: 1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.14);
      overflow-x:auto;
      scrollbar-width: thin;
    }
    .thumbs::-webkit-scrollbar{ height: 8px; }
    .thumbs::-webkit-scrollbar-thumb{
      background: rgba(255,255,255,.10);
      border-radius: 999px;
    }

    .thumb{
      flex: 0 0 auto;
      width: 84px;
      height: 84px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.12);
      overflow:hidden;
      background: rgba(255,255,255,.03);
      cursor:pointer;
      transition: .15s ease;
      padding: 0;
      outline: none;
    }
    .thumb:hover{
      transform: translateY(-1px);
      border-color: rgba(255,255,255,.22);
    }
    .thumb:focus{
      border-color: rgba(255,255,255,.26);
      box-shadow: 0 0 0 4px rgba(255,255,255,.08);
    }
    .thumb img{
      width:100%;
      height:100%;
      object-fit: cover;
      display:block;
    }
    .thumb.active{
      border-color: rgba(255,255,255,.28);
      box-shadow: 0 0 0 4px rgba(255,255,255,.08);
    }

    .galleryHint{
      position:absolute;
      right: 12px;
      bottom: 12px;
      padding: 8px 10px;
      border-radius: 999px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.35);
      color: rgba(238,241,255,.78);
      font-weight: 900;
      font-size: 12px;
      backdrop-filter: blur(8px);
      user-select:none;
    }

    /* Neutralize “hot” chips if your CSS has color versions */
    .chipHot{
      border-color: rgba(255,255,255,.16) !important;
      background: rgba(255,255,255,.06) !important;
      color: rgba(238,241,255,.92) !important;
    }

    .discordBox{
      margin-top: 12px;
      padding: 14px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.22);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 12px;
    }
    .discordLeft{ display:flex; flex-direction:column; gap:6px; }
    .discordTitle{ font-weight: 1000; letter-spacing:-.2px; }
    .discordDesc{ color: rgba(238,241,255,.72); font-size: 12px; line-height: 1.35; }
    .discordBtn{
      padding: 10px 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      color: rgba(238,241,255,.92);
      font-weight: 950;
      text-decoration:none;
      white-space: nowrap;
      transition:.15s ease;
    }
    .discordBtn:hover{
      transform: translateY(-1px);
      border-color: rgba(255,255,255,.22);
      background: rgba(255,255,255,.08);
    }
  </style>
</head>

<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark">
          <img src="/favicon.ico" alt="Imprev logo">
        </span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/admin">Admin</a>
        <a href="https://discord.gg/eUd4qP4DV8" target="_blank" rel="noopener noreferrer">Discord</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="crumbs">
      <a href="/">Home</a>
      <span class="dot">•</span>
      <span><%= product ? product.name : "Not found" %></span>
    </div>

    <% if (!product) { %>
      <section class="pCard">
        <div class="pHead">
          <div class="pTitle">Not found</div>
          <div class="pDesc">This product does not exist or is disabled.</div>
        </div>
      </section>
    <% } else { %>

      <% const imgs = (product.images || []).filter(Boolean); %>

      <div class="pWrap">
        <div class="gallery">
          <div class="galleryMain">
            <img id="mainImg" src="<%= imgs.length ? imgs[0] : '' %>" alt="" />
            <% if (imgs.length > 1) { %>
              <div class="galleryHint">Tap thumbnails or use ← →</div>
            <% } %>
          </div>

          <% if (imgs.length > 1) { %>
            <div class="thumbs" id="thumbs">
              <% for (let i = 0; i < imgs.length; i++) { %>
                <button
                  type="button"
                  class="thumb <%= i === 0 ? 'active' : '' %>"
                  data-i="<%= i %>"
                  aria-label="View image <%= i+1 %>"
                >
                  <img src="<%= imgs[i] %>" alt="">
                </button>
              <% } %>
            </div>
          <% } %>
        </div>

        <div class="pCard">
          <div class="pHead">
            <div class="pTitle"><%= product.name %></div>
            <div class="pDesc"><%= product.description %></div>

            <div class="chips">
              <span class="chip chipHot">Drop</span>
              <span class="chip">Print-on-demand</span>
              <span class="chip">Ships global</span>
            </div>

            <div class="discordBox">
              <div class="discordLeft">
                <div class="discordTitle">Join the Imprev Discord</div>
                <div class="discordDesc">Drops, updates, early access, and support.</div>
              </div>
              <a class="discordBtn" href="https://discord.gg/eUd4qP4DV8" target="_blank" rel="noopener noreferrer">Join</a>
            </div>
          </div>

          <% if (!product.variants || !product.variants.length) { %>
            <div class="formBox">
              <div class="warn2">No variants yet. Add variants in Admin and enable the product.</div>
            </div>
          <% } else { %>
            <form method="POST" action="/checkout" class="formBox">
              <input type="hidden" name="productId" value="<%= product._id %>">

              <label>Variant</label>
              <select name="variantSku" required>
                <% for (let i = 0; i < product.variants.length; i++) { const v = product.variants[i]; %>
                  <option value="<%= v.sku %>"><%= v.name %></option>
                <% } %>
              </select>

              <div class="row2">
                <div>
                  <label>Size</label>
                  <input name="size" placeholder="S / M / L / XL" required />
                </div>
                <div>
                  <label>Qty</label>
                  <input name="qty" type="number" min="1" max="10" value="1" required />
                </div>
              </div>

              <div class="row2">
                <div>
                  <label>Country code</label>
                  <input name="country" value="GB" required />
                </div>
                <div>
                  <label>Email (receipt)</label>
                  <input name="email" type="email" placeholder="you@example.com" />
                </div>
              </div>

              <button class="btn2" type="submit">Checkout</button>

              <div class="notice2">You should be redirected to Stripe Checkout.</div>
            </form>
          <% } %>
        </div>
      </div>

      <% if (imgs.length > 1) { %>
        <script>
          (function(){
            const imgs = <%- JSON.stringify(imgs) %>;
            let idx = 0;

            const main = document.getElementById("mainImg");
            const thumbs = Array.from(document.querySelectorAll(".thumb"));

            function setIndex(i){
              idx = (i + imgs.length) % imgs.length;
              main.src = imgs[idx];
              thumbs.forEach((t, n) => t.classList.toggle("active", n === idx));
            }

            thumbs.forEach(t => {
              t.addEventListener("click", () => setIndex(Number(t.dataset.i || 0)));
            });

            document.addEventListener("keydown", (e) => {
              if (e.key === "ArrowLeft") setIndex(idx - 1);
              if (e.key === "ArrowRight") setIndex(idx + 1);
            });
          })();
        </script>
      <% } %>

    <% } %>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
