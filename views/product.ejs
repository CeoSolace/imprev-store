<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= product ? product.name : "Product" %> • Imprev Clothing</title>

  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />

  <link rel="stylesheet" href="/style.css" />
  <style>
    :root{
      --bg: #0e1016;
      --card: rgba(255,255,255,.06);
      --border: rgba(255,255,255,.10);
      --text: #eef1ff;
      --muted: rgba(238,241,255,.65);
      --accent: #6c7cff;
    }

    body{
      background:
        radial-gradient(1200px 600px at 20% -10%, rgba(108,124,255,.12), transparent 40%),
        radial-gradient(800px 400px at 90% 10%, rgba(255,255,255,.04), transparent 40%),
        var(--bg);
    }

    .crumbs{
      display:flex; gap:10px; align-items:center;
      margin: 10px 0 18px;
      color: var(--muted);
      font-weight: 900; font-size: 13px;
    }
    .crumbs a{ color: rgba(238,241,255,.85); text-decoration:none; }
    .crumbs a:hover{ text-decoration: underline; }
    .dot{ opacity:.4; }

    .pWrap{
      display:grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 20px;
      align-items:start;
      margin-top: 10px;
    }
    @media (max-width: 980px){ .pWrap{ grid-template-columns: 1fr; } }

    .pCard{
      border-radius: 22px;
      border:1px solid var(--border);
      background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
      box-shadow: 0 20px 50px rgba(0,0,0,.45);
      overflow:hidden;
      backdrop-filter: blur(6px);
    }

    /* --- Gallery --- */
    .gallery{
      border-radius: 22px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.25);
      overflow:hidden;
      box-shadow: 0 20px 50px rgba(0,0,0,.45);
    }

    .galleryMain{ position: relative; }
    .galleryMain img{
      width:100%; height: 540px; object-fit: cover; display:block;
      transition: opacity .25s ease, transform .25s ease;
    }
    @media (max-width: 980px){ .galleryMain img{ height: 420px; } }
    @media (max-width: 520px){ .galleryMain img{ height: 320px; } }

    .galleryMain::after{
      content:"";
      position:absolute; inset:0;
      background: linear-gradient(180deg, transparent 70%, rgba(0,0,0,.35));
      pointer-events:none;
    }

    .thumbs{
      display:flex; gap:12px; padding: 14px;
      border-top: 1px solid var(--border);
      background: rgba(0,0,0,.20);
      overflow-x:auto;
      scrollbar-width: thin;
    }

    .thumb{
      flex: 0 0 auto;
      width: 80px; height: 80px;
      border-radius: 16px;
      border:1px solid var(--border);
      overflow:hidden;
      background: rgba(255,255,255,.04);
      cursor:pointer; position:relative;
      transition: .15s ease;
      padding:0;
      outline:none;
    }
    .thumb:hover{ transform: translateY(-2px) scale(1.02); border-color: rgba(255,255,255,.22); }
    .thumb.active{ border-color: var(--accent); box-shadow: 0 0 0 3px rgba(108,124,255,.35); }
    .thumb img{ width:100%; height:100%; object-fit: cover; display:block; }

    .galleryHint{
      position:absolute; right: 14px; bottom: 14px;
      padding: 8px 12px;
      border-radius: 999px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.45);
      color: rgba(238,241,255,.85);
      font-weight: 900; font-size: 12px;
      backdrop-filter: blur(10px);
      user-select:none;
    }

    .pHead{ padding: 22px; }
    .pTitle{
      font-size: 36px;
      letter-spacing:-1px;
      font-weight: 1000;
      line-height:1.05;
      background: linear-gradient(180deg, #ffffff, #cfd6ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .pPrice{
      margin-top: 8px;
      font-size: 26px;
      font-weight: 1000;
      color: #ffffff;
      letter-spacing: -.5px;
    }

    .pDesc{
      margin-top: 12px;
      color: var(--muted);
      line-height: 1.6;
      font-size: 15px;
      max-width: 60ch;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .chips{ margin-top: 14px; display:flex; gap:8px; flex-wrap:wrap; }
    .chip{
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,.25);
      color: rgba(238,241,255,.82);
      font-weight: 900; font-size: 12px;
    }
    .chipHot{
      border-color: rgba(108,124,255,.45);
      background: rgba(108,124,255,.15);
      color: #f1f3ff;
    }

    /* Discord card */
    .discordBox{
      margin-top: 16px;
      padding: 16px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      display:flex; align-items:center; justify-content:space-between; gap: 12px;
    }
    .discordLeft{ display:flex; flex-direction:column; gap:6px; }
    .discordTitle{ font-weight: 1000; }
    .discordDesc{ color: var(--muted); font-size: 12px; }
    .discordBtn{
      padding: 10px 14px;
      border-radius: 14px;
      border:1px solid rgba(108,124,255,.45);
      background: linear-gradient(180deg, rgba(108,124,255,.35), rgba(108,124,255,.20));
      color: #fff; font-weight: 950; text-decoration:none;
      transition:.15s ease;
      white-space: nowrap;
    }
    .discordBtn:hover{ transform: translateY(-1px); box-shadow: 0 6px 20px rgba(108,124,255,.35); }

    .formBox{ padding: 22px; border-top:1px solid var(--border); }

    .formBox label{
      display:block; margin-top: 12px; margin-bottom: 6px;
      font-weight: 950; color: rgba(238,241,255,.9);
      font-size: 13px;
    }

    .formBox input, .formBox select{
      width:100%; padding: 12px 14px;
      border-radius: 14px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.35);
      color: #fff; outline:none;
      transition: .15s ease;
    }
    .formBox input:focus, .formBox select:focus{
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(108,124,255,.25);
    }

    .row2{ display:grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
    @media (max-width: 520px){ .row2{ grid-template-columns: 1fr; } }

    .btn2{
      margin-top: 18px; width:100%;
      padding: 14px 16px;
      border-radius: 16px;
      border:1px solid rgba(108,124,255,.55);
      background: linear-gradient(180deg, rgba(108,124,255,.45), rgba(108,124,255,.25));
      color: #fff;
      font-weight: 1000; letter-spacing:.3px;
      cursor:pointer; transition:.15s ease;
    }
    .btn2:hover{ transform: translateY(-2px); box-shadow: 0 10px 30px rgba(108,124,255,.45); }

    .notice2{
      margin-top: 14px; padding: 14px;
      border-radius: 16px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.25);
      color: var(--muted);
      line-height: 1.5; font-size: 12px; font-weight: 800;
    }

    .warn2{
      margin-top: 14px; padding: 14px;
      border-radius: 16px;
      border:1px solid rgba(255,90,90,.35);
      background: rgba(255,90,90,.12);
      color: #ffe0e0; font-weight: 900;
    }
  </style>
</head>

<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/admin">Admin</a>
        <a href="https://discord.gg/eUd4qP4DV8" target="_blank" rel="noopener noreferrer">Discord</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="crumbs">
      <a href="/">Home</a>
      <span class="dot">•</span>
      <span><%= product ? product.name : "Not found" %></span>
    </div>

    <% if (!product) { %>
      <section class="pCard">
        <div class="pHead">
          <div class="pTitle">Not found</div>
          <div class="pDesc">This product does not exist or is disabled.</div>
        </div>
      </section>
    <% } else { %>

      <% const imgs = (product.images || []).filter(Boolean); %>

      <div class="pWrap">
        <div class="gallery">
          <div class="galleryMain">
            <img id="mainImg" src="<%= imgs.length ? imgs[0] : '' %>" alt="" />
            <% if (imgs.length > 1) { %>
              <div class="galleryHint">Tap thumbnails or use ← →</div>
            <% } %>
          </div>

          <% if (imgs.length > 1) { %>
            <div class="thumbs" id="thumbs">
              <% for (let i = 0; i < imgs.length; i++) { %>
                <button
                  type="button"
                  class="thumb <%= i === 0 ? 'active' : '' %>"
                  data-i="<%= i %>"
                  aria-label="View image <%= i+1 %>"
                >
                  <img src="<%= imgs[i] %>" alt="">
                </button>
              <% } %>
            </div>
          <% } %>
        </div>

        <div class="pCard">
          <div class="pHead">
            <div class="pTitle"><%= product.name %></div>
            <% if (product.basePrice) { %>
              <div class="pPrice">£<%= product.basePrice.toFixed ? product.basePrice.toFixed(2) : product.basePrice %></div>
            <% } %>
            <div class="pDesc"><%= product.description %></div>

            <div class="chips">
              <span class="chip chipHot">Drop</span>
              <span class="chip">Print-on-demand</span>
              <span class="chip">Ships global</span>
            </div>

            <div class="discordBox">
              <div class="discordLeft">
                <div class="discordTitle">Join the Imprev Discord</div>
                <div class="discordDesc">Drops, updates, early access, and support.</div>
              </div>
              <a class="discordBtn" href="https://discord.gg/eUd4qP4DV8" target="_blank" rel="noopener noreferrer">Join</a>
            </div>
          </div>

          <% if (!product.variants || !product.variants.length) { %>
            <div class="formBox">
              <div class="warn2">No variants yet. Add variants in Admin and enable the product.</div>
            </div>
          <% } else { %>
            <form id="checkoutForm" method="POST" action="/checkout" class="formBox">
              <input type="hidden" name="productId" value="<%= product._id %>">

              <label>Variant</label>
              <select name="variantSku" required>
                <% for (let i = 0; i < product.variants.length; i++) { const v = product.variants[i]; %>
                  <option value="<%= v.sku %>"><%= v.name %></option>
                <% } %>
              </select>

              <div class="row2">
                <div>
                  <label>Size</label>
                  <input name="size" placeholder="S / M / L / XL" required />
                </div>
                <div>
                  <label>Qty</label>
                  <input name="qty" type="number" min="1" max="10" value="1" required />
                </div>
              </div>

              <div class="row2">
                <div>
                  <label>Country code</label>
                  <input name="country" value="GB" required />
                </div>
                <div>
                  <label>Email (receipt)</label>
                  <input name="email" type="email" placeholder="you@example.com" />
                </div>
              </div>

              <div class="row2">
                <div>
                  <label>Reference code (optional)</label>
                  <input name="referenceCode" placeholder="SOLCORD_DROP" />
                </div>
                <div>
                  <label>Referral code (optional)</label>
                  <input name="referralCode" placeholder="IMPREV10" />
                </div>
              </div>

              <button class="btn2" type="submit">Checkout</button>

              <div class="notice2">
                Price is calculated at checkout to cover Printful + shipping + Stripe fees + your profit.
                Country code controls region pricing.
              </div>
            </form>
          <% } %>
        </div>
      </div>

      <% if (imgs.length > 1) { %>
        <script>
          (function(){
            const imgs = <%- JSON.stringify(imgs) %>;
            let idx = 0;

            const main = document.getElementById("mainImg");
            const thumbs = Array.from(document.querySelectorAll(".thumb"));

            function setIndex(i){
              idx = (i + imgs.length) % imgs.length;
              main.style.opacity = 0;
              setTimeout(() => {
                main.src = imgs[idx];
                main.style.opacity = 1;
              }, 120);
              thumbs.forEach((t, n) => t.classList.toggle("active", n === idx));
            }

            thumbs.forEach(t => {
              t.addEventListener("click", () => setIndex(Number(t.dataset.i || 0)));
            });

            document.addEventListener("keydown", (e) => {
              if (e.key === "ArrowLeft") setIndex(idx - 1);
              if (e.key === "ArrowRight") setIndex(idx + 1);
            });
          })();
        </script>
      <% } %>

      <!-- Checkout redirect fix -->
      <script>
        (function(){
          const form = document.getElementById("checkoutForm");
          if (!form) return;

          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const fd = new FormData(form);
            try {
              const resp = await fetch(form.action, {
                method: "POST",
                headers: { "Accept": "application/json" },
                body: new URLSearchParams(fd),
              });

              if (!resp.ok) {
                const t = await resp.text();
                alert(t || "Checkout failed.");
                return;
              }

              const data = await resp.json();
              if (data && data.url) {
                window.location.assign(data.url);
                return;
              }

              alert("Checkout URL missing.");
            } catch (err) {
              form.submit();
            }
          });
        })();
      </script>

    <% } %>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
