<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= product ? product.name : "Product" %> • Imprev Clothing</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    .crumbs{
      display:flex;
      gap:10px;
      align-items:center;
      margin: 10px 0 14px;
      color: rgba(238,241,255,.62);
      font-weight: 900;
      font-size: 13px;
    }
    .crumbs a{ color: rgba(238,241,255,.78); text-decoration:none; }
    .crumbs a:hover{ text-decoration: underline; }
    .dot{ opacity:.4; }

    .pWrap{
      display:grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 16px;
      align-items:start;
      margin-top: 10px;
    }
    @media (max-width: 980px){ .pWrap{ grid-template-columns: 1fr; } }

    .pCard{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.08);
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
      overflow:hidden;
    }

    .gallery{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.08);
      background: rgba(0,0,0,.18);
      overflow:hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    .gallery img{
      width:100%;
      height: 520px;
      object-fit: cover;
      display:block;
    }
    @media (max-width: 980px){ .gallery img{ height: 420px; } }
    @media (max-width: 520px){ .gallery img{ height: 340px; } }

    .pHead{ padding: 16px; }
    .pTitle{ font-size: 34px; letter-spacing:-.8px; font-weight: 1000; line-height:1.08; }
    .pDesc{
      margin-top: 10px;
      color: rgba(238,241,255,.72);
      line-height: 1.55;
      font-size: 14px;

      /* clamp if someone writes an essay */
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .chips{
      margin-top: 12px;
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }
    .chip{
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      color: rgba(238,241,255,.80);
      font-weight: 900;
      font-size: 12px;
    }
    .chipHot{
      border-color: rgba(46,229,157,.22);
      background: rgba(46,229,157,.12);
      color: rgba(210,255,238,.95);
    }

    .formBox{
      padding: 16px;
    }
    .formBox label{
      display:block;
      margin-top: 10px;
      margin-bottom: 6px;
      font-weight: 950;
      color: rgba(238,241,255,.82);
    }
    .formBox input, .formBox select{
      width:100%;
      padding: 12px 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.22);
      color: rgba(238,241,255,.95);
      outline:none;
    }
    .formBox input:focus, .formBox select:focus{
      border-color: rgba(124,92,255,.55);
      box-shadow: 0 0 0 4px rgba(124,92,255,.15);
    }

    .row2{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
    }
    @media (max-width: 520px){ .row2{ grid-template-columns: 1fr; } }

    .btn2{
      margin-top: 14px;
      width:100%;
      padding: 12px 14px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.10);
      background: linear-gradient(135deg, rgba(124,92,255,.95), rgba(124,92,255,.55));
      color:#0b0d12;
      font-weight: 1000;
      letter-spacing:.2px;
      cursor:pointer;
      transition:.15s ease;
    }
    .btn2:hover{ transform: translateY(-1px); filter: brightness(1.05); }

    .notice2{
      margin-top: 12px;
      padding: 12px;
      border-radius: 16px;
      border:1px solid rgba(255,255,255,.08);
      background: rgba(0,0,0,.18);
      color: rgba(238,241,255,.70);
      line-height: 1.45;
      font-size: 12px;
      font-weight: 800;
    }
    .warn2{
      margin-top: 12px;
      padding: 12px;
      border-radius: 16px;
      border:1px solid rgba(255,90,90,.18);
      background: rgba(255,90,90,.08);
      color: rgba(255,220,220,.92);
      font-weight: 900;
      line-height: 1.45;
    }
  </style>
</head>

<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/admin">Admin</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="crumbs">
      <a href="/">Home</a>
      <span class="dot">•</span>
      <span><%= product ? product.name : "Not found" %></span>
    </div>

    <% if (!product) { %>
      <section class="pCard">
        <div class="pHead">
          <div class="pTitle">Not found</div>
          <div class="pDesc">This product does not exist or is disabled.</div>
        </div>
      </section>
    <% } else { %>

      <div class="pWrap">
        <div class="gallery">
          <img src="<%= (product.images && product.images[0]) ? product.images[0] : '' %>" alt="">
        </div>

        <div class="pCard">
          <div class="pHead">
            <div class="pTitle"><%= product.name %></div>
            <div class="pDesc"><%= product.description %></div>

            <div class="chips">
              <span class="chip chipHot">Drop</span>
              <span class="chip">Print-on-demand</span>
              <span class="chip">Ships global</span>
            </div>
          </div>

          <% if (!product.variants || !product.variants.length) { %>
            <div class="formBox">
              <div class="warn2">No variants yet. Add variants in Admin and enable the product.</div>
            </div>
          <% } else { %>
            <form method="POST" action="/checkout" class="formBox">
              <input type="hidden" name="productId" value="<%= product._id %>">

              <label>Variant</label>
              <select name="variantSku" required>
                <% for (let i = 0; i < product.variants.length; i++) { const v = product.variants[i]; %>
                  <option value="<%= v.sku %>"><%= v.name %></option>
                <% } %>
              </select>

              <div class="row2">
                <div>
                  <label>Size</label>
                  <input name="size" placeholder="S / M / L / XL" required />
                </div>
                <div>
                  <label>Qty</label>
                  <input name="qty" type="number" min="1" max="10" value="1" required />
                </div>
              </div>

              <div class="row2">
                <div>
                  <label>Country code</label>
                  <input name="country" value="GB" required />
                </div>
                <div>
                  <label>Email (receipt)</label>
                  <input name="email" type="email" placeholder="you@example.com" />
                </div>
              </div>

              <div class="row2">
                <div>
                  <label>Reference code (optional)</label>
                  <input name="referenceCode" placeholder="SOLCORD_DROP" />
                </div>
                <div>
                  <label>Referral code (optional)</label>
                  <input name="referralCode" placeholder="IMPREV10" />
                </div>
              </div>

              <button class="btn2" type="submit">Checkout</button>

              <div class="notice2">
                Price is calculated at checkout to cover Printful + shipping + Stripe fees + your profit.
                Country code controls region pricing.
              </div>
            </form>
          <% } %>
        </div>
      </div>

    <% } %>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
