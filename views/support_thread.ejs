<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Ticket <%= ticket.publicId %> • Imprev Support</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/">Store</a>
        <a href="/support">New ticket</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="box" style="max-width: 980px;">
      <div class="h">Support Ticket: <%= ticket.publicId %></div>
      <div class="muted">
        <%= ticket.subject || "No subject" %>
        <% if (ticket.email) { %> • <%= ticket.email %> <% } %>
        • Status: <span id="ticketStatus"><%= ticket.status %></span>
        <span style="float:right; opacity:.7;">This chat updates live.</span>
      </div>

      <input type="hidden" id="ticketPublicId" value="<%= ticket.publicId %>">
      <input type="hidden" id="ticketRole" value="user">

      <div id="chatList" class="chatList"></div>

      <div class="chatBar">
        <textarea id="chatInput" rows="2" placeholder="Type your message…"></textarea>
        <button class="btn" id="chatSend" type="button">Send</button>
      </div>

      <div class="muted" style="margin-top:10px;">
        Discord issues: ask the staff of the Discord. Website support can’t help with Discord moderation/server problems.
      </div>
    </section>
  </main>

  <footer class="foot">© Imprev Clothing</footer>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/support.js"></script>
</body>
</html>
