<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= store.name %> • Imprev</title>
  <style>
    body {
      margin: 0;
      background: #0b0f14;
      color: white;
      font-family: Inter, sans-serif;
    }

    .banner {
      height: 240px;
      background-size: cover;
      background-position: center;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .content {
      max-width: 1200px;
      margin: auto;
      padding: 32px;
    }

    .header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: -60px;
    }

    .logo {
      width: 120px;
      height: 120px;
      border-radius: 24px;
      object-fit: cover;
      border: 4px solid #0b0f14;
      background: #111827;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }

    .card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      overflow: hidden;
    }

    .card img {
      width: 100%;
      height: 260px;
      object-fit: cover;
    }

    .card-body {
      padding: 18px;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div
    class="banner"
    style="background-image:url('<%= store.banner || "https://placehold.co/1200x300" %>')"
  ></div>

  <div class="content">
    <div class="header">
      <img class="logo" src="<%= store.logo || 'https://placehold.co/200' %>" />

      <div>
        <h1><%= store.name %></h1>
        <p><%= store.bio %></p>
      </div>
    </div>

    <div class="products">
      <% products.forEach(product => { %>
        <a href="/p/<%= product._id %>">
          <div class="card">
            <img src="<%= product.images?.[0] || 'https://placehold.co/600x600' %>" />

            <div class="card-body">
              <h3><%= product.name %></h3>
              <p><%= product.category %></p>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</body>
</html>
