<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>New Product • Imprev Admin</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="a">
  <div class="bar">
    <div class="logo"><a href="/admin/products">← Products</a></div>
    <div class="barLinks">
      <a href="/admin">Dashboard</a>
    </div>
  </div>

  <div class="wrapA">
    <h1>New Product</h1>
    <p class="muted">Upload 1–4 images. Product will be inactive until you enable it.</p>

    <form method="POST" action="/admin/products/new" enctype="multipart/form-data" class="panel2">
      <label>Name</label>
      <input name="name" required placeholder="Imprev Hoodie" />

      <label>Description</label>
      <textarea name="description" rows="4" required placeholder="Heavyweight hoodie..."></textarea>

      <label>Images (up to 4)</label>
      <input type="file" name="images" accept="image/*" multiple />

      <button type="submit" style="margin-top:14px;">Create Product</button>
    </form>
  </div>
</body>
</html>
