<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Admin Login • Imprev</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="a">
  <form method="POST" action="/admin/login" class="panel">
    <h1>Imprev Admin</h1>
    <p class="muted">Log in to manage products, pricing, codes, and orders.</p>

    <% if (err) { %><p class="err"><%= err %></p><% } %>

    <label>Email</label>
    <input name="email" placeholder="admin@email.com" required />

    <label>Password</label>
    <input name="password" type="password" placeholder="••••••••" required />

    <button type="submit" style="margin-top:14px;width:100%;">Login</button>
  </form>
</body>
</html>
