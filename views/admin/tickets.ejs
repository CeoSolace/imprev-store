<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Tickets • Admin</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/admin"><span class="brandMark"></span><span>Admin</span></a>
      <nav class="nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/tickets">Tickets</a>
        <form action="/admin/logout" method="POST" style="display:inline;">
          <button class="btn" type="submit" style="width:auto;margin:0;padding:10px 12px;border-radius:999px;">Logout</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="box">
      <div class="h">Support Tickets</div>
      <p class="muted">Open/close/delete tickets. Replies are stored in the database.</p>

      <form method="GET" action="/admin/tickets" class="row2">
        <div>
          <label>Status</label>
          <select name="status">
            <option value="open" <%= status==="open" ? "selected" : "" %>>Open</option>
            <option value="closed" <%= status==="closed" ? "selected" : "" %>>Closed</option>
            <option value="all" <%= status==="all" ? "selected" : "" %>>All</option>
          </select>
        </div>
        <div>
          <label>Search</label>
          <input name="q" value="<%= q || "" %>" placeholder="publicId, email, subject" />
        </div>
        <div style="grid-column: 1 / -1;">
          <button class="btn" type="submit">Filter</button>
        </div>
      </form>
    </div>

    <div class="grid" style="grid-template-columns: 1fr; margin-top: 14px;">
      <% if (tickets && tickets.length) { %>
        <% for (const t of tickets) { %>
          <a class="card" href="/admin/tickets/<%= t._id %>">
            <div class="cardBody">
              <div class="h"><%= t.publicId %> • <%= (t.subject || "No subject") %></div>
              <div class="d" style="-webkit-line-clamp: 3;">
                <%= (t.email ? ("From: " + t.email + " • ") : "") %>
                <%= "Status: " + t.status + (t.category ? (" • " + t.category) : "") %>
              </div>
              <div class="muted">
                Created: <%= new Date(t.createdAt).toLocaleString() %>
              </div>
            </div>
          </a>
        <% } %>
      <% } else { %>
        <div class="box">
          <div class="muted">No tickets found.</div>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
