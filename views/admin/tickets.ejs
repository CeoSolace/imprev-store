<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Tickets • Imprev Admin</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="a">
  <div class="bar">
    <div class="logo">Imprev Admin</div>
    <div class="barRight">
      <a class="barLink" href="/admin">Dashboard</a>
      <form method="POST" action="/admin/logout"><button class="btnSmall" type="submit">Logout</button></form>
    </div>
  </div>

  <div class="wrapA">
    <div class="pageHead">
      <div>
        <h1>Tickets</h1>
        <p class="muted">Open = active. Closed = archived. Users can reopen by replying.</p>
      </div>

      <form class="ticketSearch" method="GET" action="/admin/tickets">
        <input
          name="q"
          value="<%= q || '' %>"
          placeholder="Search code, email, subject..."
          autocomplete="off"
        />
        <button class="btnSmall" type="submit">Search</button>
      </form>
    </div>

    <div class="tabs">
      <a class="tab <%= (tab === 'open') ? 'active' : '' %>" href="/admin/tickets?tab=open<%= q ? ('&q=' + encodeURIComponent(q)) : '' %>">Open</a>
      <a class="tab <%= (tab === 'closed') ? 'active' : '' %>" href="/admin/tickets?tab=closed<%= q ? ('&q=' + encodeURIComponent(q)) : '' %>">Closed</a>
    </div>

    <div class="tableCard">
      <div class="tableHead">
        <div>Ticket</div>
        <div>User</div>
        <div>Status</div>
        <div>Updated</div>
        <div class="right">Action</div>
      </div>

      <% if (!tickets || !tickets.length) { %>
        <div class="emptyRow">
          No tickets found.
        </div>
      <% } else { %>
        <% for (let i = 0; i < tickets.length; i++) { const t = tickets[i]; %>
          <div class="tableRow">
            <div class="cell">
              <div class="ticketCode"><%= t.publicId %></div>
              <div class="ticketSub"><%= (t.subject || 'Support Ticket') %></div>
              <div class="ticketPreview"><%= (t.lastText || '').slice(0, 90) %><%= (t.lastText && t.lastText.length > 90) ? '…' : '' %></div>
            </div>

            <div class="cell">
              <div class="ticketEmail"><%= t.email || 'No email' %></div>
            </div>

            <div class="cell">
              <span class="pill <%= (t.status === 'closed') ? 'pillClosed' : 'pillOpen' %>">
                <%= t.status || 'open' %>
              </span>
            </div>

            <div class="cell">
              <%= t.updatedAt ? new Date(t.updatedAt).toLocaleString() : '' %>
            </div>

            <div class="cell right">
              <a class="btnGhost" href="/admin/tickets/<%= t.publicId %>">Open</a>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</body>
</html>
