<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= product.name %> • Admin • Imprev Clothing</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    .adminTopRow{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
      margin-bottom: 12px;
    }
    .adminTopRow .left{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .pill2{
      padding:8px 10px;
      border-radius: 999px;
      border:1px solid var(--border);
      background: rgba(255,255,255,.03);
      color: var(--muted);
      font-weight:900;
      font-size: 13px;
    }
    .row3{
      display:grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap:10px;
    }
    @media (max-width: 900px){ .row3{ grid-template-columns: 1fr; } }

    table{
      width:100%;
      border-collapse: collapse;
      overflow:hidden;
      border-radius: var(--r16);
      border:1px solid var(--border);
      background: rgba(255,255,255,.02);
    }
    th, td{
      padding: 10px;
      border-bottom:1px solid rgba(255,255,255,.06);
      vertical-align: top;
      text-align:left;
      font-size: 13px;
      color: rgba(238,241,255,.85);
    }
    th{ color: rgba(238,241,255,.65); font-weight: 1000; letter-spacing:.2px; text-transform: uppercase; font-size:12px; }
    tr:last-child td{ border-bottom: none; }

    .btnSmall{
      width:auto;
      padding: 9px 12px;
      margin-top: 0;
      border-radius: 12px;
    }
    .dangerBtn{
      background: rgba(255,90,90,.12);
      border-color: rgba(255,90,90,.35);
      color: rgba(255,220,220,.95);
    }
    .dangerBtn:hover{ filter: brightness(1.05); }

    .mutedBox{
      margin-top: 10px;
      padding: 12px;
      border-radius: var(--r16);
      border:1px solid rgba(255,255,255,.08);
      background: rgba(0,0,0,.18);
      color: rgba(238,241,255,.65);
      font-weight: 900;
      font-size: 12px;
      line-height: 1.45;
    }
    .rowCard{
      border-radius: var(--r16);
      border:1px solid rgba(255,255,255,.08);
      background: rgba(0,0,0,.14);
      padding: 12px;
    }
  </style>
</head>

<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/settings">Settings</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="adminTopRow">
      <div class="left">
        <div class="pill2">Editing</div>
        <div class="pill2"><%= product.name %></div>
        <div class="pill2">Status: <%= product.active ? "LIVE" : "DISABLED" %></div>
      </div>

      <div class="left">
        <form method="POST" action="/admin/products/<%= product._id %>/toggle">
          <button class="btn btnSmall" type="submit"><%= product.active ? "Disable" : "Enable" %></button>
        </form>
        <form method="POST" action="/admin/products/<%= product._id %>/delete" onsubmit="return confirm('Delete this product?');">
          <button class="btn btnSmall dangerBtn" type="submit">Delete</button>
        </form>
      </div>
    </div>

    <section class="box">
      <div class="h">Images</div>
      <div class="muted" style="margin-top:6px;">First image is used as the product cover.</div>

      <div class="grid" style="margin-top:12px;">
        <% (product.images || []).forEach((u) => { %>
          <div class="card" style="overflow:hidden;">
            <img src="<%= u %>" alt="">
            <div class="cardBody">
              <form method="POST" action="/admin/products/<%= product._id %>/remove-image">
                <input type="hidden" name="url" value="<%= u %>">
                <button class="btn btnSmall dangerBtn" type="submit">Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <form method="POST" action="/admin/products/<%= product._id %>/add-image" enctype="multipart/form-data" style="margin-top:14px;">
        <label>Add image</label>
        <input type="file" name="image" accept="image/*" required />
        <button class="btn" type="submit">Upload</button>
      </form>
    </section>

    <section class="box" style="margin-top:14px;">
      <div class="h">Current Variants</div>
      <div class="muted" style="margin-top:6px;">SKU is the unique key. Delete removes it from this product.</div>

      <% if (!product.variants || !product.variants.length) { %>
        <div class="warn">No variants yet.</div>
      <% } else { %>
        <div style="overflow:auto; margin-top:12px;">
          <table>
            <thead>
              <tr>
                <th>SKU</th>
                <th>Name</th>
                <th>Sizes</th>
                <th>Printful Variant</th>
                <th>Manufacturing (GBP)</th>
                <th>UK (GBP)</th>
                <th>US (USD)</th>
                <th>EU/TR/ROW</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% product.variants.forEach((v) => { %>
                <tr>
                  <td><%= v.sku %></td>
                  <td><%= v.name %></td>
                  <td><%= (v.sizes || []).join(", ") %></td>
                  <td><%= v.printfulVariantId %></td>
                  <td><%= Number(v.costs?.manufacturing ?? 0).toFixed(2) %></td>
                  <td>
                    Ship: <%= Number(v.costs?.shipping?.UK ?? 0).toFixed(2) %><br>
                    Profit: <%= Number(v.profit?.UK ?? 0).toFixed(2) %>
                  </td>
                  <td>
                    Ship: <%= Number(v.costs?.shipping?.US ?? 0).toFixed(2) %><br>
                    Profit: <%= Number(v.profit?.US ?? 0).toFixed(2) %>
                  </td>
                  <td style="color: rgba(238,241,255,.65); font-weight:900;">
                    EU Ship: <%= Number(v.costs?.shipping?.EU ?? 0).toFixed(2) %> / Profit: <%= Number(v.profit?.EU ?? 0).toFixed(2) %><br>
                    TR Ship: <%= Number(v.costs?.shipping?.TR ?? 0).toFixed(2) %> / Profit: <%= Number(v.profit?.TR ?? 0).toFixed(2) %><br>
                    ROW Ship: <%= Number(v.costs?.shipping?.ROW ?? 0).toFixed(2) %> / Profit: <%= Number(v.profit?.ROW ?? 0).toFixed(2) %>
                  </td>
                  <td style="white-space:nowrap;">
                    <form method="POST" action="/admin/products/<%= product._id %>/variant-delete" onsubmit="return confirm('Delete variant <%= v.sku %>?');">
                      <input type="hidden" name="sku" value="<%= v.sku %>">
                      <button class="btn btnSmall dangerBtn" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="box" style="margin-top:14px;">
      <div class="h">Add / Update Variants (Bulk)</div>
      <div class="muted" style="margin-top:6px;">
        Add multiple rows, submit once. Existing SKUs will be updated.
        EU/TR/ROW are kept at 0 by default to satisfy your schema.
      </div>

      <div class="mutedBox">
        Schema requires UK/EU/US/TR/ROW. You can ignore EU/TR/ROW for now.
        If you want them later, change the hidden fields to visible inputs.
      </div>

      <form method="POST" action="/admin/products/<%= product._id %>/variant" id="variantsForm" style="margin-top:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
          <div class="pill2">Rows: <span id="rowCount">1</span></div>
          <button class="btn btnSmall" type="button" id="addRow">+ Add row</button>
        </div>

        <div id="variantRows" style="margin-top:12px; display:flex; flex-direction:column; gap:12px;">
          <div class="rowCard variantRow">
            <div class="row2">
              <div>
                <label>SKU</label>
                <input name="sku" placeholder="AS5082-FB-S" required />
              </div>
              <div>
                <label>Variant name</label>
                <input name="vname" placeholder="Faded Black / S" required />
              </div>
            </div>

            <div class="row2">
              <div>
                <label>Sizes (comma)</label>
                <input name="sizes" placeholder="S,M,L,XL,2XL,3XL" required />
              </div>
              <div>
                <label>Printful Variant ID</label>
                <input name="printfulVariantId" type="number" placeholder="17569" required />
              </div>
            </div>

            <div class="row3">
              <div>
                <label>Manufacturing (GBP)</label>
                <input name="manufacturing" type="number" step="0.01" placeholder="19.45" required />
              </div>
              <div>
                <label>Shipping UK (GBP)</label>
                <input name="shipUK" type="number" step="0.01" placeholder="3.99" required />
              </div>
              <div>
                <label>Profit UK (GBP)</label>
                <input name="profitUK" type="number" step="0.01" placeholder="10.00" required />
              </div>
            </div>

            <div class="row3">
              <div>
                <label>Shipping US (USD)</label>
                <input name="shipUS" type="number" step="0.01" placeholder="6.99" required />
              </div>
              <div>
                <label>Profit US (USD)</label>
                <input name="profitUS" type="number" step="0.01" placeholder="12.00" required />
              </div>
              <div style="display:flex; align-items:flex-end;">
                <button type="button" class="btn btnSmall dangerBtn removeRow">Remove row</button>
              </div>
            </div>

            <!-- ✅ schema-required fields defaulted -->
            <input type="hidden" name="shipEU" value="0">
            <input type="hidden" name="shipTR" value="0">
            <input type="hidden" name="shipROW" value="0">

            <input type="hidden" name="profitEU" value="0">
            <input type="hidden" name="profitTR" value="0">
            <input type="hidden" name="profitROW" value="0">
          </div>
        </div>

        <button class="btn" type="submit" style="margin-top:12px;">Save all variants</button>
      </form>
    </section>
  </main>

  <footer class="foot">© Imprev Clothing</footer>

  <script>
    const container = document.getElementById("variantRows");
    const addBtn = document.getElementById("addRow");
    const countEl = document.getElementById("rowCount");

    function updateCount(){
      countEl.textContent = String(container.querySelectorAll(".variantRow").length);
    }

    function wireRow(row){
      const btn = row.querySelector(".removeRow");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const rows = container.querySelectorAll(".variantRow");
        if (rows.length <= 1) {
          row.querySelectorAll("input").forEach(i => {
            if (i.type !== "hidden") i.value = "";
          });
        } else {
          row.remove();
        }
        updateCount();
      });
    }

    function cloneRow(){
      const base = container.querySelector(".variantRow");
      const clone = base.cloneNode(true);

      clone.querySelectorAll("input").forEach(i => {
        // keep hidden defaults intact, clear everything else
        if (i.type !== "hidden") i.value = "";
      });

      container.appendChild(clone);
      wireRow(clone);
      updateCount();
      clone.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    wireRow(container.querySelector(".variantRow"));
    updateCount();
    addBtn.addEventListener("click", cloneRow);
  </script>
</body>
</html>
