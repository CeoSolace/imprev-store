<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Edit Product • Imprev Admin</title>
  <link rel="stylesheet" href="/admin.css" />
  <style>
    .tableWrap { overflow:auto; border-radius: 16px; border:1px solid rgba(255,255,255,.08); }
    table.pricing { width: 100%; border-collapse: collapse; min-width: 900px; }
    table.pricing th, table.pricing td { padding: 10px; border-bottom:1px solid rgba(255,255,255,.08); vertical-align: top; }
    table.pricing th { text-align:left; font-weight: 950; color: rgba(238,241,255,.85); background: rgba(255,255,255,.03); position: sticky; top: 0; }
    .mini { font-size: 12px; color: rgba(238,241,255,.55); line-height:1.4; margin-top:6px; }
    .kpi { display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; }
    .chip { padding:6px 10px; border:1px solid rgba(255,255,255,.08); border-radius:999px; background: rgba(0,0,0,.15); font-weight:900; font-size:12px; color: rgba(238,241,255,.75); }
    .ok { border-color: rgba(46,229,157,.25); color: rgba(210,255,238,.9); background: rgba(46,229,157,.08); }
    .bad { border-color: rgba(255,90,90,.25); color: rgba(255,190,190,.95); background: rgba(255,90,90,.08); }
    .tight input { max-width: 180px; }
  </style>
</head>
<body class="a">
  <div class="bar">
    <div class="logo"><a href="/admin/products">← Products</a></div>
    <div class="barLinks">
      <form method="POST" action="/admin/products/<%= product._id %>/toggle" style="margin:0;">
        <button type="submit"><%= product.active ? "Disable" : "Enable" %></button>
      </form>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/settings">Settings</a>
    </div>
  </div>

  <div class="wrapA">
    <h1><%= product.name %></h1>
    <p class="muted">
      Status: <%= product.active ? "Active" : "Inactive" %> • ID: <%= product._id %>
    </p>

    <div class="panel2">
      <h2>Pricing (GBP + USD)</h2>
      <p class="muted">
        You enter: <b>Manufacturing + Shipping + Profit</b>.
        The system calculates the <b>Customer Price</b> so you never pay out of pocket:
        <br/>
        Customer Price − Stripe Fee − Manufacturing − Shipping = Profit
      </p>
      <p class="muted">
        Use <b>minor units</b>: £1.00 = 100, $1.00 = 100
      </p>
    </div>

    <div class="panel2" style="margin-top:14px;">
      <h2>Existing variants</h2>

      <div class="list">
        <% var vs = (product.variants || []); %>
        <% for (var i = 0; i < vs.length; i++) { var v = vs[i]; %>
          <div class="row">
            <div>
              <div class="title"><%= v.name %> <span class="pill">SKU: <%= v.sku %></span></div>
              <div class="muted">Printful Variant ID: <%= v.printfulVariantId %></div>
              <div class="muted">Sizes: <%= (v.sizes || []).join(", ") %></div>
            </div>
            <div class="actions">
              <form method="POST" action="/admin/products/<%= product._id %>/variant-delete" onsubmit="return confirm('Delete variant?');">
                <input type="hidden" name="sku" value="<%= v.sku %>" />
                <button type="submit" class="danger">Delete</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="panel2 tight" style="margin-top:14px;">
      <h2>Add / Update Variant</h2>

      <% 
        // Stripe fee config (fallback defaults if missing)
        var F = fee || {};
        var ukPct = (F.UK && typeof F.UK.percent === "number") ? F.UK.percent : 0.029;
        var ukFix = (F.UK && typeof F.UK.fixed === "number") ? F.UK.fixed : 30;

        var usPct = (F.US && typeof F.US.percent === "number") ? F.US.percent : 0.029;
        var usFix = (F.US && typeof F.US.fixed === "number") ? F.US.fixed : 30;
      %>

      <form method="POST" action="/admin/products/<%= product._id %>/variant" id="variantForm">
        <div class="grid2">
          <div>
            <label>SKU (unique)</label>
            <input name="sku" required placeholder="gaming-tee-fadedblack-s" />
          </div>
          <div>
            <label>Variant name</label>
            <input name="vname" required placeholder="Tee (Faded Black / S)" />
          </div>
        </div>

        <label>Sizes (comma-separated)</label>
        <input name="sizes" required placeholder="S,M,L,XL,2XL,3XL" />

        <label>Printful Variant ID</label>
        <input name="printfulVariantId" type="number" required placeholder="17569" />

        <hr class="sep"/>

        <h3>Manufacturing cost (Printful)</h3>
        <label>Manufacturing (minor units)</label>
        <input name="manufacturing" id="manufacturing" type="number" required value="0" />
        <div class="mini">Example: £18.40 → 1840</div>

        <hr class="sep"/>

        <h3>Shipping + Profit per currency</h3>

        <div class="tableWrap">
          <table class="pricing" id="pricingTable">
            <thead>
              <tr>
                <th style="min-width:140px;">Currency</th>
                <th>Stripe fee</th>
                <th>Shipping (minor)</th>
                <th>Profit (minor)</th>
                <th>Customer Price (minor)</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr data-key="UK" data-percent="<%= ukPct %>" data-fixed="<%= ukFix %>">
                <td><span class="pill">GBP</span></td>
                <td class="mini"><%= Math.round(ukPct * 1000) / 10 %>% + <%= ukFix %></td>
                <td>
                  <input name="shipUK" type="number" value="0" />
                  <div class="mini">Shipping cost you pay Printful (UK).</div>
                </td>
                <td>
                  <input name="profitUK" type="number" value="0" />
                  <div class="mini">Profit you keep (GBP).</div>
                </td>
                <td>
                  <input type="number" readonly id="price_UK" value="0" />
                  <div class="mini">Auto retail price.</div>
                </td>
                <td>
                  <span class="chip" id="check_UK">—</span>
                </td>
              </tr>

              <tr data-key="US" data-percent="<%= usPct %>" data-fixed="<%= usFix %>">
                <td><span class="pill">USD</span></td>
                <td class="mini"><%= Math.round(usPct * 1000) / 10 %>% + <%= usFix %></td>
                <td>
                  <input name="shipUS" type="number" value="0" />
                  <div class="mini">Shipping cost you pay Printful (US/Intl).</div>
                </td>
                <td>
                  <input name="profitUS" type="number" value="0" />
                  <div class="mini">Profit you keep (USD).</div>
                </td>
                <td>
                  <input type="number" readonly id="price_US" value="0" />
                  <div class="mini">Auto retail price.</div>
                </td>
                <td>
                  <span class="chip" id="check_US">—</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Hidden zeros so your backend schema still receives the other regions -->
        <input type="hidden" name="shipEU" value="0" />
        <input type="hidden" name="shipTR" value="0" />
        <input type="hidden" name="shipROW" value="0" />

        <input type="hidden" name="profitEU" value="0" />
        <input type="hidden" name="profitTR" value="0" />
        <input type="hidden" name="profitROW" value="0" />

        <button type="submit" style="margin-top:14px;">Save Variant</button>

        <p class="muted" style="margin-top:10px;">
          Customer Price is calculated so: retail covers manufacturing + shipping + Stripe fees + your profit.
        </p>
      </form>
    </div>
  </div>

  <script>
    function calcRetail(baseCost, profit, percent, fixed) {
      // retail - (retail*percent + fixed) - baseCost = profit
      // retail*(1-percent) = baseCost + profit + fixed
      var raw = (baseCost + profit + fixed) / (1 - percent);
      return Math.ceil(raw / 10) * 10; // round up to nearest 10 minor units
    }

    function stripeFeeForRetail(retail, percent, fixed) {
      return Math.round(retail * percent) + fixed;
    }

    function num(v){ return Number(v || 0); }

    function update() {
      var manu = num(document.getElementById("manufacturing").value);

      var rows = document.querySelectorAll("#pricingTable tbody tr");
      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var key = row.getAttribute("data-key");
        var percent = num(row.getAttribute("data-percent"));
        var fixed = num(row.getAttribute("data-fixed"));

        var ship = num(row.querySelector('input[name="ship' + key + '"]').value);
        var profit = num(row.querySelector('input[name="profit' + key + '"]').value);

        var baseCost = manu + ship;
        var retail = calcRetail(baseCost, profit, percent, fixed);
        var fee = stripeFeeForRetail(retail, percent, fixed);
        var realized = retail - fee - baseCost;

        document.getElementById("price_" + key).value = retail;

        var chip = document.getElementById("check_" + key);
        if (retail > 0 && realized >= profit) {
          chip.textContent = "OK • est profit " + realized;
          chip.className = "chip ok";
        } else {
          chip.textContent = "BAD • est profit " + realized;
          chip.className = "chip bad";
        }
      }
    }

    document.getElementById("variantForm").addEventListener("input", update);
    update();
  </script>
</body>
</html>
