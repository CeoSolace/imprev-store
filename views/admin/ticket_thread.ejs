<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Ticket <%= ticket.publicId %> • Imprev Admin</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="a">
  <div class="bar">
    <div class="logo"><a href="/admin">Imprev Admin</a></div>
    <div class="barRight">
      <a class="barLink" href="/admin/tickets">Tickets</a>
      <form method="POST" action="/admin/logout"><button class="btnSmall" type="submit">Logout</button></form>
    </div>
  </div>

  <div class="wrapA">
    <div class="panel2 chatPanel">
      <div class="chatHeadA">
        <div>
          <div class="chatTitleA">Ticket: <%= ticket.publicId %></div>
          <div class="muted">
            <%= ticket.subject || "Support" %>
            <% if (ticket.email) { %> • <%= ticket.email %> <% } %>
            • Status: <%= ticket.status %>
          </div>
        </div>

        <div class="chatActions">
          <form method="POST" action="/admin/tickets/<%= ticket.publicId %>/toggle">
            <button type="submit"><%= ticket.status === "closed" ? "Reopen" : "Close" %></button>
          </form>

          <form method="POST" action="/admin/tickets/<%= ticket.publicId %>/delete" onsubmit="return confirm('Delete ticket?');">
            <button class="danger" type="submit">Delete</button>
          </form>
        </div>
      </div>

      <div id="log" class="chatLogA">
        <% for (let i=0;i<ticket.messages.length;i++){ const m=ticket.messages[i]; %>
          <div class="msgA <%= m.by %>">
            <div class="msgTopA">
              <span><%= m.by %></span>
              <span><%= new Date(m.ts).toLocaleString() %></span>
            </div>
            <div><%= m.text %></div>
          </div>
        <% } %>
      </div>

      <div class="chatSendA">
        <textarea id="text" placeholder="Reply as admin…"></textarea>
        <button id="send" type="button">Send</button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    (function(){
      const publicId = "<%= ticket.publicId %>";
      const log = document.getElementById("log");
      const text = document.getElementById("text");
      const send = document.getElementById("send");

      const socket = io({ path: "/socket.io" });

      function scrollBottom(){ log.scrollTop = log.scrollHeight; }
      scrollBottom();

      socket.emit("join_ticket", { publicId, role: "admin" }, (res) => {
        if (!res || !res.ok) {
          console.error(res);
          alert("Admin auth failed. Log in again.");
        }
      });

      socket.on("message", (m) => {
        const el = document.createElement("div");
        el.className = "msgA " + (m.by || "user");
        el.innerHTML =
          '<div class="msgTopA"><span>' + (m.by||"user") + '</span><span>' +
          new Date(m.ts).toLocaleString() +
          '</span></div><div></div>';
        el.querySelector("div:last-child").textContent = m.text || "";
        log.appendChild(el);
        scrollBottom();
      });

      function doSend(){
        const v = (text.value || "").trim();
        if (!v) return;
        send.disabled = true;
        socket.emit("send_message", { text: v }, (res) => {
          send.disabled = false;
          if (!res || !res.ok) {
            alert("Failed to send.");
            return;
          }
          text.value = "";
          text.focus();
        });
      }

      send.addEventListener("click", doSend);
      text.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          doSend();
        }
      });
    })();
  </script>
</body>
</html>
