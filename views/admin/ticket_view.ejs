<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= ticket.publicId %> • Ticket</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/admin"><span class="brandMark"></span><span>Admin</span></a>
      <nav class="nav">
        <a href="/admin/tickets">Back</a>
        <form action="/admin/logout" method="POST" style="display:inline;">
          <button class="btn" type="submit" style="width:auto;margin:0;padding:10px 12px;border-radius:999px;">Logout</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="box">
      <div class="h"><%= ticket.publicId %> • <%= ticket.status.toUpperCase() %></div>
      <div class="muted">
        <%= ticket.email ? ("Email: " + ticket.email + " • ") : "" %>
        <%= ticket.subject ? ("Subject: " + ticket.subject + " • ") : "" %>
        <%= ticket.category ? ("Category: " + ticket.category) : "" %>
      </div>
      <div class="muted">Created: <%= new Date(ticket.createdAt).toLocaleString() %></div>

      <% if (err) { %>
        <div class="warn"><%= err %></div>
      <% } %>
    </div>

    <div class="box" style="margin-top:14px;">
      <div class="h">Conversation</div>
      <div style="margin-top:12px; display:flex; flex-direction:column; gap:10px;">
        <% for (const m of (ticket.messages || [])) { %>
          <div class="notice" style="border-color: rgba(255,255,255,.10); background: rgba(0,0,0,.18);">
            <div style="font-weight:950;">
              <%= (m.from || "user").toUpperCase() %>
              <span style="opacity:.6;font-weight:800;">
                • <%= m.createdAt ? new Date(m.createdAt).toLocaleString() : "" %>
              </span>
            </div>
            <div style="margin-top:8px; white-space:pre-wrap; line-height:1.5; color: rgba(238,241,255,.82);">
              <%= m.text %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="box" style="margin-top:14px;">
      <div class="h">Reply</div>

      <form method="POST" action="/admin/tickets/<%= ticket._id %>/reply">
        <label>Message</label>
        <textarea name="text" rows="5" placeholder="Write response..." ></textarea>

        <div class="row2">
          <div>
            <label>Close ticket?</label>
            <select name="close">
              <option value="0">No</option>
              <option value="1">Yes (close)</option>
            </select>
          </div>
          <div style="display:flex;align-items:flex-end;">
            <button class="btn" type="submit">Send reply</button>
          </div>
        </div>
      </form>

      <% if (ticket.status === "closed") { %>
        <form method="POST" action="/admin/tickets/<%= ticket._id %>/reopen" style="margin-top:10px;">
          <button class="btn" type="submit" style="background: rgba(255,255,255,.08); color: rgba(238,241,255,.95); border-color: rgba(255,255,255,.14);">Re-open</button>
        </form>
      <% } %>

      <form method="POST" action="/admin/tickets/<%= ticket._id %>/delete" style="margin-top:10px;">
        <button class="btn" type="submit" style="background: rgba(255,90,90,.10); color: rgba(255,220,220,.92); border-color: rgba(255,90,90,.20);">
          Delete ticket
        </button>
      </form>
    </div>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
