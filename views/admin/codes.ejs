<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Codes • Imprev Admin</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="a">
  <div class="bar">
    <div class="logo"><a href="/admin">Imprev Admin</a></div>
    <div class="barLinks">
      <a href="/admin/products">Products</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/settings">Settings</a>
    </div>
  </div>

  <div class="wrapA">
    <h1>Codes</h1>
    <p class="muted">Reference codes track campaigns. Referral codes discount ONLY your profit portion.</p>

    <form method="POST" action="/admin/codes/new" class="panel2">
      <div class="grid2">
        <div>
          <label>Type</label>
          <select name="type">
            <option value="reference">Reference (tracking)</option>
            <option value="referral">Referral (discount)</option>
          </select>
        </div>
        <div>
          <label>Code</label>
          <input name="code" required placeholder="IMPREV10" />
        </div>
      </div>

      <div class="grid2">
        <div>
          <label>Discount % (referral only)</label>
          <input name="discountPercent" type="number" value="0" />
        </div>
        <div>
          <label>Max uses (0 = unlimited)</label>
          <input name="maxUses" type="number" value="0" />
        </div>
      </div>

      <label>Note</label>
      <input name="note" placeholder="TikTok creator code / drop tracking" />

      <button type="submit" style="margin-top:14px;">Create Code</button>
    </form>

    <h2>Existing</h2>

    <div class="list">
      <% codes.forEach(c => { %>
        <div class="row">
          <div>
            <div class="title">
              <%= c.code %>
              <span class="pill"><%= c.type %></span>
              <span class="pill"><%= c.active ? "active" : "inactive" %></span>
            </div>

            <div class="muted">
              <% if (c.type === "referral") { %>
                Discount: <%= c.discountPercent %>% • Used: <%= c.used %>/<%= c.maxUses || "∞" %>
              <% } else { %>
                Tracking only
              <% } %>
              • <%= c.note || "" %>
            </div>
          </div>

          <div class="actions">
            <form method="POST" action="/admin/codes/<%= c._id %>/toggle">
              <button type="submit"><%= c.active ? "Disable" : "Enable" %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
