<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Support • Imprev Clothing</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>
      <nav class="nav">
        <a href="/">Store</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="box">
      <div class="h">Support</div>
      <div class="muted">Send a ticket. You’ll get an automatic reply, then staff can respond in Admin.</div>

      <% if (error) { %>
        <div class="warn"><strong>Problem:</strong> <%= error %></div>
      <% } %>

      <% if (created) { %>
        <div class="notice">
          <div><strong>Ticket created:</strong> <%= created.publicId %></div>
          <div style="margin-top:8px;"><strong>Auto-reply:</strong> <%= created.systemReply %></div>
        </div>
      <% } %>

      <form method="POST" action="/support">
        <label>Email (optional)</label>
        <input name="email" type="email" placeholder="you@example.com" />

        <label>Subject (optional)</label>
        <input name="subject" placeholder="What’s this about?" />

        <label>Message</label>
        <textarea name="message" rows="6" placeholder="Describe the issue. If it’s an order: receipt email + tracking + country." required></textarea>

        <button class="btn" type="submit">Submit ticket</button>

        <div class="muted">
          Discord issues? Ask Discord staff. Website support can’t handle Discord moderation or server problems.
        </div>
      </form>
    </section>
  </main>

  <footer class="foot">© Imprev Clothing</footer>
</body>
</html>
