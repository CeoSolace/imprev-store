.discordBox{
  margin-top: 16px;
  padding: 16px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.10);
  background: linear-gradient(
    135deg,
    rgba(124,92,255,.14),
    rgba(46,229,157,.08)
  );
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.discordLeft{
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.discordTitle{
  font-weight: 1000;
  letter-spacing: -.2px;
}

.discordDesc{
  font-size: 13px;
  color: rgba(238,241,255,.75);
  line-height: 1.4;
}

.discordBtn{
  padding: 10px 14px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.12);
  background: linear-gradient(
    135deg,
    rgba(124,92,255,.95),
    rgba(124,92,255,.55)
  );
  color: #0b0d12;
  font-weight: 950;
  text-decoration: none;
  white-space: nowrap;
  transition: .15s ease;
}

.discordBtn:hover{
  transform: translateY(-1px);
  filter: brightness(1.05);
}

@media (max-width: 520px){
  .discordBox{
    flex-direction: column;
    align-items: stretch;
  }
  .discordBtn{
    text-align: center;
  }
}
