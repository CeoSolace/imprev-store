<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Imprev Clothing</title>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" />

  <!-- Main styles -->
  <link rel="stylesheet" href="/style.css" />

  <style>
    /* Page-specific layout only — NO COLORS */
    .hero{
      margin: 10px 0 18px;
      padding: 22px;
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }

    .heroTitle{
      font-size: 42px;
      font-weight: 1000;
      letter-spacing: -1px;
    }

    .heroSub{
      margin-top: 10px;
      color: rgba(242,244,255,.72);
      max-width: 70ch;
      line-height: 1.55;
    }

    .searchWrap{
      margin-top: 14px;
    }

    .search{
      width:100%;
      padding: 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.25);
      color: #f2f4ff;
      outline:none;
    }

    .search:focus{
      border-color: rgba(255,255,255,.30);
      box-shadow: 0 0 0 4px rgba(255,255,255,.08);
    }

    .empty{
      padding: 22px;
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      box-shadow: 0 10px 30px rgba(0,0,0,.30);
    }

    .empty h2{
      margin:0;
      font-size: 26px;
      font-weight: 1000;
    }

    .empty p{
      margin-top: 8px;
      color: rgba(242,244,255,.70);
    }
  </style>
</head>

<body>
  <!-- Header -->
  <header class="top">
    <div class="topInner">
      <a class="brand" href="/">
        <span class="brandMark"></span>
        <span>Imprev Clothing</span>
      </a>

      <nav class="nav">
        <a href="https://discord.gg/eUd4qP4DV8" target="_blank" rel="noopener noreferrer">Discord</a>
        <a href="#terms">TOS</a>
        <a href="#privacy">Privacy</a>
        <% if (products && products.length) { %>
          <a href="/admin">Admin</a>
        <% } %>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="wrap">
    <!-- Hero -->
    <section class="hero">
      <h1 class="heroTitle">Imprev Clothing</h1>
      <p class="heroSub">
        Limited drops. Print-on-demand fulfillment. No inventory, no shortcuts,
        no nonsense.
      </p>

      <div class="searchWrap">
        <input
          id="q"
          class="search"
          placeholder="Search products…"
          autocomplete="off"
        />
      </div>
    </section>

    <!-- Products -->
    <div id="products" class="grid">
      <% if (products && products.length) { %>
        <% for (let i = 0; i < products.length; i++) { const p = products[i]; %>
          <a
            class="card productCard"
            href="/p/<%= p._id %>"
            data-name="<%= (p.name || '').toLowerCase() %>"
            data-desc="<%= (p.description || '').toLowerCase() %>"
          >
            <% if (p.images && p.images[0]) { %>
              <img src="<%= p.images[0] %>" alt="<%= p.name %>">
            <% } %>

            <div class="cardBody">
              <div class="h"><%= p.name %></div>
              <div class="d"><%= p.description %></div>
            </div>
          </a>
        <% } %>
      <% } else { %>
        <div class="empty">
          <h2>No products yet</h2>
          <p>
            First drop is being finalized. Check back soon.
          </p>
        </div>
      <% } %>
    </div>

    <!-- Terms -->
    <section id="terms" class="box" style="margin-top:22px;">
      <h2 class="h">Terms of Service</h2>
      <p class="muted">
        All products are print-on-demand. Refunds are only issued for confirmed
        defects or damage. Abuse of chargebacks or disputes will result in
        refusal of service.
      </p>
    </section>

    <!-- Privacy -->
    <section id="privacy" class="box" style="margin-top:14px;">
      <h2 class="h">Privacy Policy</h2>
      <p class="muted">
        We only collect information required to fulfill your order. Data is not
        sold or shared beyond fulfillment and payment processing.
      </p>
    </section>
  </main>

  <!-- Footer -->
  <footer class="foot">
    © <%= new Date().getFullYear() %> Imprev Clothing
  </footer>

  <!-- Search script -->
  <script>
    const q = document.getElementById("q");
    const cards = Array.from(document.querySelectorAll(".productCard"));

    function run(){
      const v = (q.value || "").trim().toLowerCase();
      for (const c of cards){
        const hay = (c.dataset.name || "") + " " + (c.dataset.desc || "");
        c.style.display = (!v || hay.includes(v)) ? "" : "none";
      }
    }

    q && q.addEventListener("input", run);
  </script>
</body>
</html>
